# Where generated stems are cached on disk (mount as a volume in Docker).
STEMS_CACHE_DIR=/data

# Demucs model; htdemucs is the balanced default, htdemucs_ft is a fine-tuned
# upgrade (slower), hts is smaller/faster.
STEMS_MODEL=htdemucs

# cpu, or cuda if the host exposes a GPU to the container.
STEMS_DEVICE=cpu

# Max concurrent generations. Keep low if CPU-only — Demucs is very heavy.
STEMS_WORKERS=1

# Comma-separated origins allowed to call this API. For the deployed site:
#   STEMS_CORS_ORIGINS=https://luszechai.github.io,https://Andy-Tsai2004.github.io
# In dev the Vite origin is http://localhost:8080. `*` is permissive but fine
# for public audio; tighten it if you publish.
STEMS_CORS_ORIGINS=*

# Listening port.
PORT=8000
